{
  "preset": "ts-jest/presets/default-esm",
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".s3-smoke-spec.ts$",
  "setupFiles": [
    "dotenv/config"
  ],
  "testTimeout": 120000,
  "maxWorkers": 1,
  "forceExit": true,
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.json",
        "useESM": true,
        "diagnostics": {
          "ignoreCodes": [
            151002
          ]
        }
      }
    ]
  }
}
