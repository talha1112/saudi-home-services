# Local development configuration for apps/backend (native PostgreSQL + Memurai/Redis).
#
#   Copy-Item .env.example .env
#   .\scripts\setup-local-env.ps1     # fills the two random secrets below; never prints them
#
# Only .env.example is tracked by git. Never commit .env or paste its values into chat/issues.
# Lines marked "YOU MUST SET" cannot be generated for you.

# development | test | production
NODE_ENV=development

# HTTP server. Use HOST=0.0.0.0 only when a phone/emulator on your network must reach the API.
PORT=3001
HOST=127.0.0.1

# Routing: final URLs look like /<API_PREFIX>/v<API_DEFAULT_VERSION>/...
API_PREFIX=api
API_DEFAULT_VERSION=1

# Comma-separated list of allowed browser origins. Leave empty to disable CORS.
# "*" is rejected when NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Swagger UI at /<API_PREFIX>/docs. Defaults to true outside production.
SWAGGER_ENABLED=true

# Per-request timeout in milliseconds (0 disables).
REQUEST_TIMEOUT_MS=30000

# --- PostgreSQL (native install) -------------------------------------------
# YOU MUST SET: replace CHANGE_ME with the password of the database user you created.
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL=postgresql://home_services_app:CHANGE_ME@127.0.0.1:5432/home_services?schema=public

# Optional, used only by `npm run test:integration`. The database name MUST end in _test:
# the tests refuse anything else, because they create and delete rows.
# TEST_DATABASE_URL=postgresql://home_services_app:CHANGE_ME@127.0.0.1:5432/home_services_test?schema=public

# --- Redis-compatible store (Memurai) --------------------------------------
# Local Memurai has no password. Use 127.0.0.1 (not "localhost": Node may try ::1 first).
# If you later add a password: redis://:PASSWORD@127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# --- Authentication ---------------------------------------------------------
# Two DIFFERENT random values of at least 32 characters. scripts/setup-local-env.ps1 generates them.
# The app refuses to start while these still contain CHANGE_ME.
JWT_ACCESS_SECRET=CHANGE_ME_run_scripts_setup_local_env_ps1
OTP_HMAC_SECRET=CHANGE_ME_run_scripts_setup_local_env_ps1

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_REFRESH_TOKEN_TTL_HOURS=12

OTP_TTL_SECONDS=300
# Wrong guesses allowed per client per number per 15 min (the whole number gets 3x this).
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Codes per number per hour; a single client IP can use at most half of it.
OTP_MAX_SENDS_PER_HOUR=6
DEFAULT_PHONE_REGION=SA

# dev      = log the OTP to the API console (development only; refused when NODE_ENV=production)
# disabled = no SMS provider; OTP requests return 503 (the production default until one is added)
SMS_PROVIDER=dev

# Reverse proxies in front of the API (so rate limits see the real client IP). 0 = none.
TRUST_PROXY_HOPS=0

# --- Worker onboarding -------------------------------------------------------
# A worker must have an uploaded national ID or iqama before submitting for review.
WORKER_REQUIRE_IDENTITY_DOCUMENT=true

# dev      = fake upload/download URLs, no files stored (development only; refused in production)
# disabled = no object storage; document endpoints return 503 (production default until storage is set up)
DOCUMENT_STORAGE=dev
DOCUMENT_URL_TTL_SECONDS=900

# --- Bookings and quotations ---------------------------------------------------
# VAT, platform commission and the minimum service charge are NOT here: they live in the
# database (pricing_settings), versioned and managed by administrators via
# /api/v1/admin/pricing-settings. `npm run db:seed` inserts one PROVISIONAL row (VAT 15%,
# commission 15%, minimum SAR 50) so development works; confirm the real figures with the business.
BOOKING_REQUEST_TTL_HOURS=48
BOOKING_MIN_LEAD_MINUTES=30
BOOKING_MAX_OPEN_PER_CUSTOMER=10
BOOKING_MAX_QUOTES=10
BOOKING_MAX_PHOTOS=5
QUOTE_DEFAULT_VALIDITY_HOURS=24
QUOTE_MAX_VALIDITY_HOURS=72
# Highest quotable service price, in halalas (1 SAR = 100 halalas). 5000000 = SAR 50,000.
QUOTE_MAX_PRICE_HALALAS=5000000
# Time to pay after accepting a quote (enforced by the payments phase).
PAYMENT_WINDOW_MINUTES=30

# --- Payments ------------------------------------------------------------------
# No real payment gateway is integrated. The default is `disabled`: starting a payment answers 503.
#   disabled = no provider (default everywhere)
#   mock     = SIMULATED checkout for local development and tests; NEVER real money; refused when
#              NODE_ENV=production (the API will not start). Enables the admin-only simulation endpoint.
PAYMENT_PROVIDER=disabled
PAYMENT_CHECKOUT_TTL_MINUTES=20
# A payment still PROCESSING after this long is listed as stale for reconciliation (never auto-resolved).
PAYMENT_STALE_AFTER_MINUTES=30
PAYMENT_WEBHOOK_MAX_BODY_BYTES=65536
PAYMENT_WEBHOOK_LEASE_SECONDS=120
# Origins a hosted checkout may send the customer back to, comma-separated. Empty = returnUrl not accepted.
PAYMENT_RETURN_URL_ORIGINS=

# --- Realtime, live position, chat, background jobs (Phase 7) -------------------
# Full contract and operations notes: docs/REALTIME.md. All values below are the defaults.
REALTIME_ENABLED=true
# Share Socket.IO rooms between several API instances through Redis. Needs Redis; with a single
# instance it may be false.
REALTIME_REDIS_ADAPTER=true
REALTIME_MAX_MESSAGE_BYTES=16384
REALTIME_MAX_SOCKETS_PER_USER=5
# After the access token expires a socket may wait this long for `auth.refresh`, then it is closed.
REALTIME_TOKEN_GRACE_SECONDS=30
# How often an open socket re-checks its session and every booking room it sits in.
REALTIME_REVALIDATE_SECONDS=60
# Latest worker position: kept only in Redis, gone this long after the last update.
LOCATION_TTL_SECONDS=120
LOCATION_MIN_INTERVAL_MS=2000
LOCATION_RATE_LIMIT_PER_MINUTE=30
LOCATION_MAX_AGE_SECONDS=30
LOCATION_MAX_CLOCK_SKEW_SECONDS=10
LOCATION_MAX_SPEED_MPS=70
LOCATION_MAX_ACCURACY_METERS=500
# A CONFIRMED booking shares the worker position only from this long before the preferred start (0 = no limit).
LOCATION_SHARING_LEAD_MINUTES=180
CHAT_MAX_BODY_CHARS=2000
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_PAGE_SIZE_MAX=100
# BullMQ workers (outbox delivery, cleanup, reports). At least ONE API instance must run them.
JOBS_ENABLED=true
# Redis key prefix of the queues and of the Socket.IO adapter; use a different one per environment sharing a Redis.
QUEUE_PREFIX=hs
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETENTION_DAYS=7
OUTBOX_STALE_AFTER_MINUTES=5

# --- Private storage, scanning, notifications, offers (Phase 8) -----------------
# Full explanation: docs/STORAGE_NOTIFICATIONS_OFFERS.md. Values shown are defaults unless commented out.
#   DOCUMENT_STORAGE: disabled (default; production-safe) | dev (non-routable fake) | local (real bytes on disk, dev/test only)
#                     | s3 (S3-compatible, private bucket). dev and local are refused in production.
# DOCUMENT_STORAGE=disabled
STORAGE_MAX_FILE_BYTES=10485760
# DOCUMENT_STORAGE=local only. The folder is git-ignored; the secret signs short-lived URLs (>= 32 characters).
# STORAGE_LOCAL_DIR=./.storage
# STORAGE_SIGNING_SECRET=
# PUBLIC_API_URL=http://127.0.0.1:3001
# DOCUMENT_STORAGE=s3 only. The bucket MUST be private (block public access). Credentials from the secret store.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# AWS_REGION / AWS_S3_BUCKET / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are accepted when the matching S3_* name is unset.
# Live check (PowerShell): $env:S3_SMOKE_TEST="1"; $env:S3_SMOKE_CONFIRM_BUCKET="<bucket>"; npm run test:s3-smoke
# No scanner is integrated: `disabled` leaves files NOT_SCANNED (not "clean"). `mock` is a test double, refused in production.
# FILE_SCANNER=disabled
# With true, a file is downloadable only after its scan result is CLEAN (needs a scanner).
STORAGE_REQUIRE_CLEAN_SCAN=false
# Production with DOCUMENT_STORAGE=s3 and FILE_SCANNER=disabled refuses to start unless this explicitly accepts serving unscanned files.
# STORAGE_ALLOW_UNSCANNED_FILES=false
# FILE_SCANNER also accepts mock-async (test double that scans the whole object through the queue; refused in production).
# Signed-link lifetimes in seconds. 0/unset = default: uploads and photo views use DOCUMENT_URL_TTL_SECONDS (900); identity documents use min(300, that).
# STORAGE_UPLOAD_URL_TTL_SECONDS=0
# BOOKING_PHOTO_URL_TTL_SECONDS=0
# IDENTITY_DOCUMENT_URL_TTL_SECONDS=0
# Malware-scan job (real scanner only) and abandoned-upload cleanup. See docs/FILE_LIFECYCLE.md.
# FILE_SCAN_MAX_ATTEMPTS=5
# FILE_SCAN_POLL_SECONDS=15
# FILE_SCAN_LEASE_SECONDS=300
# STORAGE_ABANDONED_UPLOAD_MIN_AGE_MINUTES=1440
# STORAGE_ABANDONED_UPLOAD_POLL_MINUTES=10
STORAGE_DELETION_MAX_ATTEMPTS=8
STORAGE_DELETION_POLL_SECONDS=30
STORAGE_DELETION_RETENTION_DAYS=7
# `disabled` (default): push deliveries are recorded as UNSUPPORTED. `fcm` = Firebase Cloud Messaging (explicit opt-in; needs FIREBASE_PROJECT_ID,
# FIREBASE_SERVICE_ACCOUNT_BASE64 and DEVICE_TOKEN_ENCRYPTION_KEY, see docs/FIREBASE_SETUP.md). `mock` accepts and sends nothing; refused in production.
# PUSH_PROVIDER=disabled
# With PUSH_PROVIDER=fcm: Firebase validates every message but delivers NOTHING (safe end-to-end check of credentials). Default false = real sends.
# FCM_DRY_RUN=false
# Base64 of 32 random bytes (AES-256-GCM key for stored push tokens). Without it device registration answers 503.
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# DEVICE_TOKEN_ENCRYPTION_KEY=
NOTIFICATION_MAX_ATTEMPTS=6
MAX_DEVICE_TOKENS_PER_USER=10

# --- Firebase Phone Authentication (customer and worker sign-in). OFF by default; independent of push notifications. ---
# When FIREBASE_AUTH_ENABLED is not true, none of the other FIREBASE_* values is read or validated. See docs/FIREBASE_SETUP.md.
# FIREBASE_AUTH_ENABLED=false
# Your Firebase project ID (not a secret). Use a separate project for development/staging: test phone numbers belong only there.
# The project for this deployment, for example saudi-home-services-b8ca5 (Firebase console -> Project settings). Shared by phone sign-in and FCM.
# FIREBASE_PROJECT_ID=
# SECRET, server only: base64 of the service-account JSON (for the revocation check, later FCM). NEVER in a mobile app or in git.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Ask Firebase whether a token was revoked. Unset = on in production (needs the service account), off elsewhere. Blank = unset.
# FIREBASE_CHECK_REVOKED=
# The SMS check must be this recent (seconds) for a token to be exchanged.
# FIREBASE_MAX_AUTH_AGE_SECONDS=300
# DEMO ONLY: let an existing account be adopted by phone match. Leave false (see docs/FIREBASE_SETUP.md, "Account linking").
# FIREBASE_ALLOW_PHONE_ACCOUNT_ADOPTION=false
# In production mode adoption ALSO needs this to equal FIREBASE_PROJECT_ID exactly (a stray "true" alone is refused at start-up).
# FIREBASE_ADOPTION_CONFIRM_PROJECT=
# Never set FIREBASE_AUTH_EMULATOR_HOST in production: the SDK would accept unsigned tokens (the API refuses to start).
