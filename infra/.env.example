# Copy to infra/.env and replace every CHANGE_ME. Never commit infra/.env.
# Use long random values, e.g.:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Avoid characters that need URL-encoding (@ : / ? # %) so DATABASE_URL stays simple.

POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=home_services
POSTGRES_TEST_DB=home_services_test
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
